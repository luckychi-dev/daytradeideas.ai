# Shared local settings
NODE_ENV=development
HOST=0.0.0.0
# Required by both services; use the same random value for each deployment.
INTERFACE_SERVICE_TOKEN=
ADMIN_API_TOKEN=

# Backend service
PORT=3000
DATABASE_URL=postgresql://daytrade:daytrade@localhost:5432/daytrade

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_INPUT_COST_PER_MTOK=0.3
DEEPSEEK_OUTPUT_COST_PER_MTOK=1.2
MODEL_MAX_OUTPUT_TOKENS=1200
# Voice notes use xAI by default. OpenAI is an optional fallback.
VOICE_TRANSCRIPTION_PROVIDER=xai
XAI_API_KEY=
XAI_MANAGEMENT_KEY=
XAI_MANAGEMENT_BASE_URL=https://management-api.x.ai
XAI_TEAM_ID=
XAI_BASE_URL=https://api.x.ai/v1
XAI_TRANSCRIBE_MODEL=grok-voice-transcribe-2.0
XAI_STT_COST_PER_HOUR=0.10
XAI_VISION_MODEL=grok-4.7
XAI_VISION_INPUT_COST_PER_MTOK=2
XAI_VISION_OUTPUT_COST_PER_MTOK=6
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_COST_PER_MINUTE=0.003
# Set to chatterbox to return voice questions as Jason Sen voice notes.
VOICE_OUTPUT_PROVIDER=disabled
CHATTERBOX_BASE_URL=https://voiceclone.altoret.com
CHATTERBOX_PASSCODE=
# Optional alternative to the passcode. Store this secret outside source control.
CHATTERBOX_SESSION_COOKIE=
CHATTERBOX_VOICE_MODE=clone
CHATTERBOX_VOICE_ID="Jason Sen 01"
CHATTERBOX_TTS_TIMEOUT_MS=120000
CHATTERBOX_TTS_COST_PER_1K_CHARS=0
WORDPRESS_BRIDGE_URL=https://www.daytradeideas.co.uk/wp-json/dtiai/v1
# Must match Settings > Day Trade Ideas AI in WordPress.
WORDPRESS_BRIDGE_SECRET=

# Private ChatGPT knowledge connector
MCP_SERVER_URL=https://api.ai.daytradeideas.co.uk/mcp
MCP_AUTH_ISSUER=https://api.ai.daytradeideas.co.uk
MCP_ADMIN_EMAILS=
# Use a unique 32+ character password. It is only used by the OAuth approval page.
MCP_ADMIN_PASSWORD=
MCP_WEB_ADMIN_URL=https://www.daytradeideas.co.uk/wp-admin/admin.php?page=dtiai-admin
MCP_ICON_URL=https://api.ai.daytradeideas.co.uk/mcp/icon.png

# Emergency bootstrap only; subscriber access uses email OTP.
TELEGRAM_ALLOWED_USER_IDS=
CONVERSATION_HISTORY_LIMIT=20
KNOWLEDGE_RESULT_LIMIT=8
KNOWLEDGE_VERSION=round2-corrections-1.0
SUBSCRIPTION_RECONCILE_INTERVAL_MINUTES=30

# Telegram interface
TELEGRAM_PORT=3001
BACKEND_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:3001
# The packaged welcome image is used by default; set the URL only to override it.
TELEGRAM_WELCOME_IMAGE_URL=

# Web interface
WEB_PORT=3002
WEB_PUBLIC_URL=http://localhost:5173
TELEGRAM_BOT_URL=https://t.me/jasonsenaibot
