{
  "name": "@daytrade/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "accept:round2": "tsx src/quality/live-mentor-acceptance.ts",
    "accept:round3": "tsx src/quality/round3-mentor-acceptance.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "ingest:staging": "tsx src/knowledge/ingest.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "mammoth": "1.13.0",
    "openai": "7.47.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/pg": "8.15.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
