{
  "name": "day-trade-ideas-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream -r dev",
    "build": "pnpm -r build",
    "start": "pnpm --parallel --stream -r start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check:file-size": "node scripts/check-file-size.mjs",
    "check": "pnpm check:file-size && pnpm typecheck && pnpm test",
    "db:migrate": "pnpm --filter @daytrade/backend db:migrate",
    "ingest:staging": "pnpm --filter @daytrade/backend ingest:staging",
    "telegram:webhook": "pnpm --filter @daytrade/telegram telegram:webhook",
    "web:dev": "pnpm --filter @daytrade/web dev",
    "web:build": "pnpm --filter @daytrade/web build"
  }
}
